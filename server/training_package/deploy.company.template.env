# 公司服务器部署参数。等号两侧不要加空格。
# BASE_IMAGE_NAME 是公司 tar 的原始标签；IMAGE_NAME 是本交付包构建出的训练镜像标签。
BASE_IMAGE_NAME=dinov2:cuda12.1-large
IMAGE_NAME=dinov2-company-training:latest

# 以下必须改成公司服务器上的绝对路径，路径中尽量不要使用空格。
DATA_DIR=/data/sem_defect_dataset
OUTPUT_DIR=/data/sem_defect_outputs

# 相对于本部署包根目录，也可以填写绝对路径。
CONFIG_FILE=config/config.company.yaml
IMAGE_TAR=docker_image/dinov2_cuda12.1_large.tar
EXPECTED_IMAGE_SHA256=1B70D47080EDF43EF434A484F61B101F27DC83BD9D8FF48CA244CDE15E3FD243

# 必须与 config/config.company.yaml 的 output_dir 最后一级一致。
MODEL_OUTPUT_SUBDIR=company_dinov2_large

# all 表示使用所有 GPU；也可以写 device=0 或 device=0,1。
GPU_SPEC=all
SHM_SIZE=8g

# true：输出文件属于当前服务器用户；若公司镜像只能以 root 读取内部文件，可改为 false。
RUN_AS_HOST_USER=true

# 可选推理参数；仅 scripts/06_predict.sh 使用。
PREDICT_INPUT_REL=predict_images
PREDICT_OUTPUT_NAME=predictions.csv
